{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shareme-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "SignalRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalRoom"] }],
  "ratelimits": [
    {
      "name": "SIGNAL_LIMIT",
      "namespace_id": "731001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "SIGNAL_BUDGET",
      "namespace_id": "731002",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
