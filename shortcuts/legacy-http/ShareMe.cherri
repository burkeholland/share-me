#define name Share Me
#define color blue
#define inputs file, image, media, pdf, text, url
#define from sharesheet
#define noinput getclipboard

#include 'actions/text'
#include 'actions/web'

// The pinned compiler's file-details helper uses WFFolder; Apple exports WFInput.
action 'properties.files' fileName(variable file: 'WFInput'): text {
    "WFContentItemPropertyName": "Name"
}

#question receiver "Paste the PC base URL shown in Share Me (including http:// and port 49321)." ""

const configuredReceiver = text(receiver)
const trimmedReceiver = trimWhitespace(configuredReceiver)
const baseURL = replaceText('/$', "", trimmedReceiver, true, true)
const validReceiver = matchText('^http://(?:10(?:\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|192\.168(?:\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){2}|172\.(?:1[6-9]|2[0-9]|3[01])(?:\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){2}):49321$', baseURL)
if !validReceiver {
    alert("Configure Share Me with the private IPv4 base URL displayed on the PC, using http:// and port 49321.", "Share Me: PC address required")
    stop()
}

@items = ShortcutInput
if !@items {
    @items = Clipboard
}
if !@items {
    alert("Share files, images, media, a PDF, text, or a URL. With no shared input, Share Me uses the clipboard.", "Share Me: nothing to send")
    stop()
}

@sent = 0
for item in @items {
    const itemType = typeOf(@item)
    @kind = "file"
    @itemName = "Text"
    @textToSend = ""
    if itemType == "Text" || itemType == "URL" {
        @kind = "text"
        @textToSend = getText(@item)
    } else {
        @itemName = fileName(@item)
        if !@itemName {
            alert("The shared file has no name. No upload was attempted.", "Share Me: missing filename")
            stop()
        }
    }

    const requestOutput = jsonRequest("{baseURL}/api/request", "POST", {
        "kind": "{@kind}",
        "name": "{@itemName}",
        "size": -1,
        "text": "{@textToSend}"
    }, {"X-Share-Me": "1"})
    const request = getDictionary(requestOutput)
    const requestError = getValue(request, "error")
    if requestError {
        alert("{requestError}", "Share Me: request failed")
        stop()
    }
    const requestID = getValue(request, "id")
    const requestToken = getValue(request, "token")
    const initialStatus = getValue(request, "status")
    if !requestID || !requestToken || initialStatus.text != "pending" {
        alert("The PC did not return a valid pending request. No upload was attempted.", "Share Me: invalid response")
        stop()
    }

    @status = "pending"
    repeat poll for 120 {
        if @status == "pending" {
            wait(1)
            const pollOutput = downloadURL("{baseURL}/api/request/{requestID}", {
                "X-Share-Me-Token": "{requestToken}"
            })
            const pollResponse = getDictionary(pollOutput)
            const pollError = getValue(pollResponse, "error")
            if pollError {
                alert("{pollError}", "Share Me: approval check failed")
                stop()
            }
            @status = "{pollResponse['status']}"
            if @status == "declined" {
                alert("The PC declined this transfer.", "Share Me: declined")
                stop()
            }
            if @status == "expired" {
                alert("The request expired before the PC accepted it.", "Share Me: expired")
                stop()
            }
            if @status != "pending" && @status != "accepted" {
                alert("The PC returned an unknown approval status. No upload was attempted.", "Share Me: invalid response")
                stop()
            }
        }
        nothing()
    }

    if @status != "accepted" {
        alert("The PC did not accept within 120 approval checks. No upload was attempted.", "Share Me: approval timed out")
        stop()
    }

    if @kind == "text" {
        @receiptOutput = formRequest("{baseURL}/api/text", "POST", {
            "text": "{@textToSend}"
        }, {
            "X-Share-Me": "1",
            "X-Share-Me-Request": "{requestID}",
            "X-Share-Me-Token": "{requestToken}"
        })
    } else {
        // Build-Shortcut.ps1 emits this field as a typed Form File, not text.
        @receiptOutput = formRequest("{baseURL}/api/upload", "POST", {
            "file": "{RepeatItem}"
        }, {
            "X-Share-Me": "1",
            "X-Share-Me-Request": "{requestID}",
            "X-Share-Me-Token": "{requestToken}"
        })
    }
    const receipt = getDictionary(@receiptOutput)
    const receiptError = getValue(receipt, "error")
    if receiptError {
        alert("{receiptError}", "Share Me: transfer failed")
        stop()
    }
    const receiptID = getValue(receipt, "id")
    if !receiptID {
        alert("The PC did not return a transfer receipt. Delivery is not confirmed.", "Share Me: missing receipt")
        stop()
    }
    @sent += 1
    nothing()
}

if @sent > 0 {
    showNotification("Sent {@sent} item(s) to the PC.", "Share Me", false)
}
